# Pokéindex REST : clé PERSONNELLE, API payante en crédits.
# Les produits sont désactivés par défaut : il faut les autoriser dans Configuration.
POKEINDEX_API_KEY=

# Pour import exceptionnel de l'historique 90j, cela peut facturer jusqu'à 90 points/produit.
# Décommenter et définir 'oui' uniquement si tu acceptes explicitement la consommation.
POKERADAR_APPROVE_HISTORY_CREDITS=non

# Discord : webhook privé ; Telegram : token @BotFather + chat_id privé.
# Ne jamais inclure ces valeurs dans un ZIP partagé.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
